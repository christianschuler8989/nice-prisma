# === RESEARCH DATA POLICY ===
# This repo MUST NOT contain copyrighted material or private data.
# Everything a run downloads or produces lives under data/ and stays local.
# Layout documented in data/README.md, which is the only tracked file there.
data/*
!data/README.md

# PDFs (publisher copyright, never commit), wherever they end up
*.pdf

# OpenAlex page cache when --cache-dir is not given (created next to --out)
.ingest-cache/

# Streamlit user uploads
streamlit_app/data/user-*

# Secrets
.env
.env.*
!.env.example
credentials*.json
*token*.json
*api-key*
*.pem
