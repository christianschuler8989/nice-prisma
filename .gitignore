# === RESEARCH DATA POLICY ===
# This repo MUST NOT contain copyrighted material or private data.
# Reviewers/users provide their own corpora; only example_corpus.ris (open access) ships.

# PDFs (publisher copyright — never commit)
*.pdf
data/raw/
data/pdfs/
data/full-texts/

# Bulk corpora (reviewers bring their own RIS)
data/scopus-*.ris
data/openalex-*.ris
data/corpus-*.csv
